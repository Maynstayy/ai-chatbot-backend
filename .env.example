# Copy to .env for local development. Never commit .env.
# Secrets (AI_API_KEY, DB_PASSWORD) belong here or in the server's
# environment only - never in the frontend.

# development | test | production
APP_ENV=development
APP_PORT=8080

# --- Hotel catalogue -------------------------------------------------------
# file  = fake test hotels from CATALOG_FILE, no database needed (default)
# mysql = the chatbot's own MySQL database (DB_* below)
CATALOG_SOURCE=file
CATALOG_FILE=testdata/catalog.json

# --- Database (CATALOG_SOURCE=mysql only) -----------------------------------
# A dedicated, disposable chatbot database. DB_NAME must be ai_chatbot_<env>
# (e.g. ai_chatbot_test); any other name, or a database containing MaynStay
# booking tables, is refused. Use a NEW user with rights on this schema only.
# Never use the MaynStay production database or its credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_chatbot_test
DB_PASSWORD=
DB_NAME=ai_chatbot_test

# Optional. Empty = conversations and rate limits in process memory.
REDIS_URL=

# --- AI provider -------------------------------------------------------------
# ollama    = local model, no key (default)
# anthropic = Claude, needs AI_API_KEY (use a key created for testing, with a spend limit)
# off       = chat answers 503
AI_PROVIDER=ollama
AI_API_KEY=
# Default: qwen2.5:1.5b for ollama, claude-opus-5-5 for anthropic
AI_MODEL=qwen2.5:1.5b
# Ollama server (unused by anthropic)
AI_BASE_URL=http://localhost:11434
AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=1024

# --- HTTP / security -----------------------------------------------------------
# Browser origins allowed to call the API, comma-separated. Required in
# production. Development defaults to http://localhost:3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Proxies (CIDRs/IPs) whose X-Forwarded-For / X-Real-IP are trusted, when
# the proxy is not on this machine (PaaS router, load balancer).
TRUSTED_PROXIES=
# Messages per minute per visitor IP.
CHATBOT_RATE_LIMIT_PER_MINUTE=20
# Development only: adds tools_used to replies. Refused in production.
CHATBOT_DEBUG=false

# --- Content the assistant shows ----------------------------------------------
SITE_URL=https://skymcm.com
SUPPORT_PHONE=+91 7607956595
SUPPORT_EMAIL=skymcm17@gmail.com
SUPPORT_WHATSAPP=

# Served at /uploads/ when the directory exists (hotel photos stored as paths).
UPLOADS_DIR=./uploads
